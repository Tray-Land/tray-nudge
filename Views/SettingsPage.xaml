<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayNudge.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Grid">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="ColumnSpacing" Value="12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid Padding="12,12,8,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="4">
            <Button
                x:Name="BackButton"
                AutomationProperties.Name="Back"
                Click="BackButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Back">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Settings" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="4,0,12,0">
            <StackPanel Padding="0,4,0,12" Spacing="6">
                <TextBlock
                    Margin="0,0,0,2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Nudges" />

                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Gentle nudges" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Friendly reminders at the times you choose for each habit."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="RemindersToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="Gentle nudges"
                        OffContent=""
                        OnContent=""
                        Toggled="RemindersToggle_Toggled" />
                </Grid>

                <Grid x:Name="PauseCard" Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Need some quiet?" />
                        <TextBlock
                            x:Name="PauseDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="PauseButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="PauseButton_Click" />
                </Grid>

                <TextBlock
                    Margin="0,14,0,2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Streaks" />

                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Never miss twice" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="One missed day won't reset a streak, as long as you pick it back up the next day."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="GentleToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="Never miss twice"
                        OffContent=""
                        OnContent=""
                        Toggled="GentleToggle_Toggled" />
                </Grid>

                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Celebrations" />
                        <TextBlock
                            x:Name="CelebrationsDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Confetti and bounces when you reach a goal."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="CelebrationsToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="Celebrations"
                        OffContent=""
                        OnContent=""
                        Toggled="CelebrationsToggle_Toggled" />
                </Grid>

                <TextBlock
                    Margin="0,14,0,2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="General" />

                <Grid Style="{StaticResource SettingsCardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" />
                        <TextBlock
                            x:Name="StartupDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="So your nudges are ready after you sign in."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="StartupToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="Start with Windows"
                        IsEnabled="False"
                        OffContent=""
                        OnContent=""
                        Toggled="StartupToggle_Toggled" />
                </Grid>

                <TextBlock
                    x:Name="VersionText"
                    Margin="0,12,0,0"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
