<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrayNudge.Views.HabitCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Padding="12,12,6,12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        ColumnSpacing="10"
        CornerRadius="8"
        RowSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Resolves the theme brush for code-built dots in the flyout's (taskbar) theme  -->
        <TextBlock
            x:Name="FaintProbe"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Visibility="Collapsed" />

        <!--  Emoji badge: tapping it (or the name) opens the habit's progress  -->
        <Border
            x:Name="EmojiBadge"
            Width="40"
            Height="40"
            VerticalAlignment="Top"
            CornerRadius="20"
            Tapped="Details_Tapped">
            <TextBlock
                x:Name="EmojiText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="20"
                Text="✨" />
        </Border>

        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Background="Transparent"
            Spacing="2"
            Tapped="Details_Tapped">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    x:Name="NameText"
                    MaxWidth="150"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
                <Border
                    x:Name="StreakPill"
                    Padding="6,1,7,2"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="10"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="StreakText"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>
            <TextBlock
                x:Name="ProgressText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>

        <!--  The one-tap log button: hollow until the day's goal is met, then filled  -->
        <Button
            x:Name="CheckButton"
            Grid.Column="2"
            Width="44"
            Height="44"
            Padding="0"
            VerticalAlignment="Top"
            Background="Transparent"
            BorderThickness="0"
            Click="CheckButton_Click"
            CornerRadius="22">
            <Grid>
                <Ellipse
                    x:Name="CheckRing"
                    Width="38"
                    Height="38"
                    StrokeThickness="2" />
                <FontIcon
                    x:Name="CheckGlyph"
                    FontSize="16"
                    FontWeight="Bold"
                    Glyph="&#xE710;" />
            </Grid>
        </Button>

        <Button
            x:Name="MoreButton"
            Grid.Column="3"
            Width="28"
            VerticalAlignment="Top"
            AutomationProperties.Name="More options"
            Style="{StaticResource FlyoutIconButtonStyle}"
            ToolTipService.ToolTip="More options">
            <FontIcon FontSize="14" Glyph="&#xE712;" />
            <Button.Flyout>
                <MenuFlyout x:Name="MoreMenu" Opening="MoreMenu_Opening" Placement="BottomEdgeAlignedRight" />
            </Button.Flyout>
        </Button>

        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="3"
            Spacing="8">
            <!--  Progress toward today's count (counted habits only)  -->
            <Grid
                x:Name="BarHost"
                Height="6"
                Margin="0,0,44,0"
                SizeChanged="BarHost_SizeChanged">
                <Border
                    Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                    CornerRadius="3"
                    Opacity="0.18" />
                <Border
                    x:Name="BarFill"
                    Width="0"
                    HorizontalAlignment="Left"
                    CornerRadius="3" />
            </Grid>
            <StackPanel x:Name="WeekStrip" Orientation="Horizontal" Spacing="9" />
            <TextBlock
                x:Name="HintText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
