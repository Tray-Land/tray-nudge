<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayNudge.Views.HabitEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="12,12,8,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="4">
            <Button
                x:Name="BackButton"
                AutomationProperties.Name="Back"
                Click="BackButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Back">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="New habit" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="4,0,12,0">
            <StackPanel Padding="0,0,0,12" Spacing="18">

                <!--  Ideas to start from (new habits only)  -->
                <StackPanel x:Name="IdeasSection" Spacing="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Start from an idea" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Or make your own below. Everything stays editable."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <VariableSizedWrapGrid
                        x:Name="IdeasGrid"
                        ItemHeight="40"
                        ItemWidth="108"
                        SizeChanged="IdeasGrid_SizeChanged"
                        MaximumRowsOrColumns="3"
                        Orientation="Horizontal" />
                </StackPanel>

                <!--  Name and emoji  -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="EmojiButton"
                        Width="48"
                        Height="48"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Choose an emoji"
                        CornerRadius="24"
                        ToolTipService.ToolTip="Choose an emoji">
                        <TextBlock x:Name="EmojiText" FontSize="22" />
                        <Button.Flyout>
                            <Flyout x:Name="EmojiFlyout" Placement="BottomEdgeAlignedLeft">
                                <VariableSizedWrapGrid
                                    x:Name="EmojiGrid"
                                    ItemHeight="38"
                                    ItemWidth="38"
                                    MaximumRowsOrColumns="8"
                                    Orientation="Horizontal" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <TextBox
                        x:Name="NameBox"
                        Grid.Column="1"
                        Header="What's the habit?"
                        MaxLength="40"
                        PlaceholderText="Drink water, journal, stretch…"
                        TextChanged="NameBox_TextChanged" />
                </Grid>

                <!--  Color  -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Color" />
                    <StackPanel x:Name="ColorRow" Orientation="Horizontal" Spacing="6" />
                </StackPanel>

                <!--  Daily goal  -->
                <StackPanel Spacing="6">
                    <TextBlock Text="How many times a day?" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox
                            x:Name="TargetBox"
                            Width="120"
                            AutomationProperties.Name="Times per day"
                            Maximum="99"
                            Minimum="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="TargetBox_ValueChanged" />
                        <TextBox
                            x:Name="UnitBox"
                            Grid.Column="1"
                            AutomationProperties.Name="Unit"
                            MaxLength="16"
                            PlaceholderText="glasses, breaks…" />
                    </Grid>
                    <TextBlock
                        x:Name="TargetHint"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Days  -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Which days?" />
                    <StackPanel x:Name="DaysRow" Orientation="Horizontal" Spacing="4" />
                    <TextBlock
                        x:Name="DaysHint"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>

                <!--  Nudges  -->
                <StackPanel Spacing="10">
                    <ComboBox
                        x:Name="ReminderBox"
                        HorizontalAlignment="Stretch"
                        Header="Gentle nudges"
                        SelectionChanged="ReminderBox_SelectionChanged">
                        <x:String>No nudges</x:String>
                        <x:String>Every so often</x:String>
                        <x:String>At set times</x:String>
                    </ComboBox>

                    <StackPanel x:Name="IntervalPanel" Spacing="10">
                        <ComboBox
                            x:Name="IntervalBox"
                            HorizontalAlignment="Stretch"
                            Header="How often" />
                        <TimePicker
                            x:Name="FromPicker"
                            HorizontalAlignment="Stretch"
                            Header="Starting at"
                            MinuteIncrement="15" />
                        <TimePicker
                            x:Name="UntilPicker"
                            HorizontalAlignment="Stretch"
                            Header="Until"
                            MinuteIncrement="15" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="If you've just logged one, the next nudge politely skips a turn."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="TimesPanel" Spacing="8">
                        <StackPanel x:Name="TimesList" Spacing="8" />
                        <Button x:Name="AddTimeButton" Click="AddTimeButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="Add a time" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!--  Delete (editing only), behind a confirmation  -->
                <Button x:Name="DeleteButton" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                        <TextBlock Text="Delete habit" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="DeleteFlyout">
                            <StackPanel MaxWidth="260" Spacing="12">
                                <TextBlock
                                    x:Name="DeletePrompt"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Its history goes with it. If you just need a break, try a rest day instead."
                                    TextWrapping="Wrap" />
                                <Button Click="ConfirmDelete_Click" Content="Delete" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="2"
            Padding="4,0,12,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                HorizontalAlignment="Stretch"
                Click="BackButton_Click"
                Content="Cancel" />
            <Button
                x:Name="SaveButton"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Click="SaveButton_Click"
                Content="Start this habit"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>
