<?xml version="1.0" encoding="utf-8"?>
<ex:WindowEx
    x:Class="TrayNudge.Views.TrayFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ex="using:WinUIEx"
    Title="Tray Nudge">

    <Grid
        x:Name="PopupRoot"
        KeyboardAcceleratorPlacementMode="Hidden"
        PointerPressed="PopupRoot_PointerPressed">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
            <KeyboardAccelerator
                Key="Left"
                Invoked="Back_Invoked"
                Modifiers="Menu" />
        </Grid.KeyboardAccelerators>
        <ContentPresenter x:Name="PageHost">
            <ContentPresenter.ContentTransitions>
                <TransitionCollection>
                    <ContentThemeTransition HorizontalOffset="24" />
                </TransitionCollection>
            </ContentPresenter.ContentTransitions>
        </ContentPresenter>

        <!--  Confetti flies above every page and never takes input  -->
        <Canvas x:Name="CelebrationLayer" IsHitTestVisible="False" />
    </Grid>
</ex:WindowEx>
